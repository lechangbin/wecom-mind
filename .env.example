APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=

WECOM_CORP_ID=
WECOM_MCP_TOKEN=
WECOM_MCP_ENCODING_AES_KEY=
# Legacy fallback. Prefer WECOM_REPLY_AIBOT_* and WECOM_INTENT_AIBOT_* below.
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=
WECOM_AIBOT_NAME=机器人
# Long-connection bot for real-time @ replies.
WECOM_REPLY_AIBOT_ID=
WECOM_REPLY_AIBOT_SECRET=
WECOM_REPLY_AIBOT_WS_URL=
WECOM_REPLY_AIBOT_NAME=机器人
# Message-fetch / intent-scan bot. It should have readable group-message permission.
WECOM_INTENT_AIBOT_ID=
WECOM_INTENT_AIBOT_SECRET=
WECOM_INTENT_AIBOT_NAME=机器人
# Compatibility aliases used by local message-fetch tooling.
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Legacy HTTP callback settings are kept only for compatibility tests.
WECOM_MCP_VERIFY_MODE=mock
# mock/app/webhook/aibot_ws. Use aibot_ws only with the long-connection worker.
WECOM_SENDER_MODE=mock
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com/cgi-bin
WECOM_AGENT_ID=
WECOM_TIMEOUT_SECONDS=10
WECOM_MAX_RETRIES=2
WECOM_GROUP_BOT_WEBHOOK_URL=
# Historical message supplement. Keep disabled until the scanner worker is started.
WECOM_MESSAGE_RECONCILE_ENABLED=false
WECOM_MESSAGE_RECONCILE_CHATIDS=
WECOM_MESSAGE_RECONCILE_INTERVAL_SECONDS=10
WECOM_MESSAGE_RECONCILE_LOOKBACK_SECONDS=12
WECOM_MESSAGE_RECONCILE_OVERLAP_SECONDS=2
WECOM_MESSAGE_RECONCILE_PAGES=1
WECOM_MESSAGE_RECONCILE_AUTO_ENQUEUE=true
WECOM_MESSAGE_RECONCILE_AUTO_SEND=false
WECOM_MCP_CONFIG_ENDPOINT=https://qyapi.weixin.qq.com/cgi-bin/aibot/cli/get_mcp_config

DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_GROUP_KNOWLEDGE_REPLY_API_KEY=
DIFY_CHAT_PROACTIVE_REMINDER_API_KEY=
DIFY_CLIENT_MODE=mock
DIFY_TIMEOUT_SECONDS=120
DIFY_MAX_RETRIES=0
DIFY_USER=wecom-bot-system

LOG_LEVEL=INFO
